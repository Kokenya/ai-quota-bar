[Unit]
Description=AI Quota Bar - Top Bar Indicator (Claude, Antigravity, Codex, Copilot)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/ai-quota-bar
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target default.target
